{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.2.0"
    },
    "kind": {
      "const": "presentation"
    },
    "analysis": {
      "$ref": "analysis.schema.json"
    },
    "blocks": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "$ref": "components/text.json#/$defs/frontend_schema"
          },
          {
            "$ref": "components/table.json#/$defs/frontend_schema"
          },
          {
            "$ref": "components/line_chart.json#/$defs/frontend_schema"
          },
          {
            "$ref": "components/bar_chart.json#/$defs/frontend_schema"
          },
          {
            "$ref": "components/timeline.json#/$defs/frontend_schema"
          },
          {
            "$ref": "components/quote.json#/$defs/frontend_schema"
          },
          {
            "$ref": "components/stacked_chart.json#/$defs/frontend_schema"
          },
          {
            "$ref": "components/scatter_plot.json#/$defs/frontend_schema"
          },
          {
            "$ref": "components/bubble_chart.json#/$defs/frontend_schema"
          },
          {
            "$ref": "components/unit_chart.json#/$defs/frontend_schema"
          },
          {
            "$ref": "components/map.json#/$defs/frontend_schema"
          },
          {
            "$ref": "components/flowchart.json#/$defs/frontend_schema"
          },
          {
            "$ref": "components/network_graph.json#/$defs/frontend_schema"
          },
          {
            "$ref": "components/word_cloud.json#/$defs/frontend_schema"
          },
          {
            "$ref": "components/treemap.json#/$defs/frontend_schema"
          }
        ]
      },
      "minItems": 1
    }
  },
  "required": [
    "schema_version",
    "kind",
    "analysis",
    "blocks"
  ],
  "additionalProperties": false
}
