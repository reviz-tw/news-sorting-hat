{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "structure_version": {
      "const": "1.0.0"
    },
    "templates": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "composition_reason": {
      "type": "string",
      "minLength": 1
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "minLength": 1
                },
                "slot": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "type",
                "slot"
              ],
              "additionalProperties": false
            },
            "minItems": 1
          },
          "reader_question": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "covered",
              "partial",
              "missing",
              "not_applicable"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "section_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0,
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "roles",
          "reader_question",
          "status",
          "reason",
          "section_ids",
          "evidence_ids"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "structure_version",
    "templates",
    "composition_reason",
    "nodes"
  ],
  "additionalProperties": false
}
